(case when (sbcs.appl_fico is not null and sbcs.co_appl_fico is not null) then (sbcs.appl_fico + sbcs.co_appl_fico)/2.0  when (sbcs.appl_fico is null and sbcs.co_appl_fico is not null) then sbcs.co_appl_fico else sbcs.appl_fico end)    as sfs_fico,
