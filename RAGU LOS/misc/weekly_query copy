    case when cd.pb_fico_score is null or cd.pb_fico_score < 350 or cd.pb_fico_score > 850 then 0 else cd.pb_fico_score end as adj_fico,
--     case when sfs_fico is null or sfs_fico< 350 or sfs_fico > 850 then 0 else sfs_fico end as adj_sfs_fico,
--     cd.pb_vantage_score as vantage,


    CASE
        WHEN dru.riskdealergroup = 'STE' THEN
            CASE
                WHEN svcb.vantage IS NULL THEN svpb.vantage
