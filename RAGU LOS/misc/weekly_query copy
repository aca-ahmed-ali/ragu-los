with sfsbb as (with bb5 as
                        (select vin, blackbook_value
                         from sandbox.shiny_blackbook_template21_reports
                         union all
                         select vin, blackbook_value
                         from sandbox.sfs_blackbook_template21_reports)
                   (select vin,
                           max(blackbook_value) as bb_value
                    from edwnpi.los_deal_current_fact cd
                             left join bb5 on bb5.vin = cd.purchase_vin
                    where cd.account_number is not null
                    group by bb5.vin)),
     allbb as (select account_number, max(bb_value) as bb_value
               --from sandbox.bbv_g
                 from sandbox.rds_blackbook_rollup
               group by account_number),
 vantage_los as (SELECT customer_id
                          , cast(MAX(CASE WHEN (attribute_name = 'Score_5402_1') THEN attribute_value END) as int) AS vantage
                     FROM odsnpi.los_customer_report_scd cr
                              left join
                          odsnpi.los_customer_report_attribute_scd cra
                          on cra.customer_report_id = cr.customer_report_id and cra.current_version_flag = 1 and
                             cr.current_version_flag = 1
                     GROUP BY customer_id
),
 ste_vantage_pb as (SELECT cd.sfs_application_number
                         , cast(MAX(COALESCE(
                               CASE WHEN attribute_name = 'Score_5402_1' AND attribute_value > 300
                                    THEN attribute_value ELSE null END,
                               CASE WHEN attribute_name = 'ConsumerCreditScore'
                                    THEN attribute_value END)) as int) AS vantage
                    FROM odsnpi.sfs_booked_contracts_scd cd
                    LEFT JOIN sandbox.sfs_customer_attributes cust
                        ON cd.application_number = cust.loan_id
                        AND cust.customer_role = 'primary'
                    WHERE cd.current_version_flag = 1
                    GROUP BY cd.sfs_application_number
),
 ste_vantage_cb as (SELECT cd.sfs_application_number
                         , cast(MAX(COALESCE(
                               CASE WHEN attribute_name = 'Score_5402_1' AND attribute_value > 300
                                    THEN attribute_value ELSE null END,
                               CASE WHEN attribute_name = 'ConsumerCreditScore'
                                    THEN attribute_value END)) as int) AS vantage
                    FROM odsnpi.sfs_booked_contracts_scd cd
                    LEFT JOIN sandbox.sfs_customer_attributes cust
                        ON cd.application_number = cust.loan_id
                        AND cust.customer_role = 'auxiliary'
                    WHERE cd.current_version_flag = 1
                    GROUP BY cd.sfs_application_number
)


