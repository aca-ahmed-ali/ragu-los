            END
        WHEN cd.book_date < '2022-04-01' THEN
            CASE
                WHEN cb_fico_score IS NULL THEN pb_fico_score
                ELSE (pb_fico_score + cb_fico_score) / 2.0
            END
        ELSE
            CASE
                WHEN cb_vantage_score IS NULL THEN pb_vantage_score
                ELSE (pb_vantage_score + cb_vantage_score) / 2.0
            END
    END AS vantage,




