def get_term_group(term: int) -> int:
    """
    Assign a term group based on the given loan term.

    :param term: Loan term in months (int).
    :return: Standardized term group (36, 48, 60, or 72 months) (int).
    """
    if term <= 38:
        return 36
    elif term <= 50:
        return 48
    elif term <= 62:
        return 60
    return 72


def get_scenario_timing(term: int, model_score: float, lob: str, current_months_on_book: int = None) -> Dict[str, float]:
    """
    Calculate scenario timing for charge-off, payoff, and total loss for non-FRN models.

    This function ports the non-FRN scenario timing logic from
    :py:func:`acariskandpricing.nonkmx_roa.mroa.get_scenario_timing`.

    :param term: Loan term in months (int).
    :param model_score: Model score (float).
    :param lob: Line of business (str).
    :param current_months_on_book: Months on book; used only for ORL scenarios (Optional[int]).
    :return: Dictionary containing ``charge_off_month``, ``pay_off_month``, and ``total_loss_month`` keys (Dict[str, float]).
    """
    adjustments = {
        "AN": 0.9452350907111133,
        "ENT": 1.0994796517684224,
        "FLD": 1.027725745972301,
        "FRN": 0.9047309801560975,
        "STG": 0.9230164639536621,
        "STE": 1.1,
        "MCY": 0.88,
    }

    term_group = get_term_group(term)
    loss_timing_term_group = 48 if term_group == 36 else term_group

    if lob == 'ORL':
        chargeoff_timing_params = {
            0: [0.35, -31, 17.5],
            6: [0.45, -40, 25],
            12: [0.55, -50, 32],
            18: [0.65, -60, 35],
            24: [0.7, -65, 40]
        }
        # bucket current_months_on_book to nearest 6-month bucket between 0..24
        mob_bucket = min(max(0, (current_months_on_book // 6) * 6), 24)
        params = chargeoff_timing_params[mob_bucket]
        charge_off_month = min(params[0] * model_score + params[1], params[2])
    else:
        charge_off_month = CO_month_constant[f"month_{loss_timing_term_group}"][0]
        charge_off_month *= adjustments.get(lob, adjustments['FRN'])
        charge_off_month += 0.3 * (model_score - 136)

    pay_off_month = PO_month_constant[f'month_{term_group}'][0]
    pay_off_month *= adjustments.get(lob, adjustments['FRN'])
    total_loss_month = pay_off_month / 2

    return {
        'charge_off_month': charge_off_month,
        'pay_off_month': pay_off_month,
        'total_loss_month': total_loss_month
    }


def get_scenario_timing_frn_4(term: int, tag: int, lob: str, model_version: str) -> Dict[str, float]:
    """
    Calculate scenario timing for franchise 4.x model versions (FRN4).

    This function ports the FRN4 scenario timing logic from
    :py:func:`acariskandpricing.nonkmx_roa.mroa.get_scenario_timing_frn_4`.

    :param term: Loan term in months (int).
    :param tag: Integer tag indexing precomputed timing tables (int).
    :param lob: Line of business (str).
    :param model_version: Model version, either ``'franchise4.0'`` or ``'franchise4.1'`` (str).
    :return: Dictionary containing ``charge_off_month``, ``pay_off_month``, and ``total_loss_month`` keys (Dict[str, float]).
    """
    adjustments = {
        "AN": 0.9452350907111133,
        "ENT": 1.0994796517684224,
        "FLD": 1.027725745972301,
        "FRN": 0.9047309801560975,
        "STG": 0.9230164639536621,
        "STE": 1.1,
        "MCY": 0.88,
    }

    co_scaling = 24.47 / 20.23
    po_scaling = 43.17 / 44.29

    if model_version == 'franchise4.1':
        co_scaling *= 20.56 / 26.94
        po_scaling *= 43.25 / 41.76
        # use FRN4 tables
        base_co = gdf_co_month_frn_41.get(tag, gdf_co_month_frn_41[0])['mean_months_co']
        base_po = gdf_po_month_frn_41.get(tag, gdf_po_month_frn_41[0])['mean_months_po']
    else:
        base_co = gdf_co_month.get(tag, gdf_co_month[0])['mean_months_co']
        base_po = po_by_tag.get(tag, 36.0)

    charge_off_month = base_co * co_scaling
    pay_off_month = base_po * po_scaling

    # Apply LOB adjustment and term scaling
    charge_off_month *= adjustments.get(lob, adjustments['FRN'])
    charge_off_month *= (0.5 * term / 72 + 0.5)

    pay_off_month *= adjustments.get(lob, adjustments['FRN'])
    pay_off_month *= (0.5 * term / 72 + 0.5)

    total_loss_month = pay_off_month / 2

    return {
        'charge_off_month': charge_off_month,
        'pay_off_month': pay_off_month,
        'total_loss_month': total_loss_month
    }


def compute_for_accounts(accounts: List[Dict]) -> Dict[str, float]:
    """
    Compute charge-off timing for each account in the provided list.

    Each account must be a dict with keys:

    - ``acct_num`` (str): Account number
    - ``term`` (int): Loan term in months
    - ``lob`` (str): Line of business
    - ``model_version`` (str): Either ``'franchise4.0'``, ``'franchise4.1'``, or other model version
    - ``model_score`` (float): Model score; used for non-FRN models (optional)
    - ``tag`` (int): Model score tag; used for FRN4 models (optional)
    - ``current_months_on_book`` (int): Months on book; used only for ORL scenarios (optional)

    :param accounts: List of account dictionaries (List[Dict]).
    :return: Mapping of account number to computed charge-off month (Dict[str, float]).
    """
    out = {}
    for acc in accounts:
        acct = acc['acct_num']
        term = int(acc['term'])
        lob = acc['lob']
        model_version = acc.get('model_version', '')
        if model_version in ('franchise4.0', 'franchise4.1'):
            tag = int(acc.get('tag', 0))
            timing = get_scenario_timing_frn_4(term, tag, lob, model_version)
        else:
            model_score = float(acc.get('model_score', 136))
            mob = int(acc.get('current_months_on_book', 0))
            timing = get_scenario_timing(term, model_score, lob, mob)
        out[acct] = timing['charge_off_month']
    return out


